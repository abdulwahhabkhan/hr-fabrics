includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 5

    excludePaths:
          - ./database/seeders/ (?)

    ignoreErrors:
        -
            # Trait is also used outside Controller, where $sessionKey is not declared.
            identifier: nullCoalesce.property
            path: app/Http/Controllers/Traits/HandlesIndexFilters.php
