includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 1

    excludePaths:
          - ./app/Actions/CutPiece (?)
          - ./app/Concerns (?)
          - ./app/Enums/HasOptions.php
          - ./database/seeders/ (?)
          - ./app/Policies (?)