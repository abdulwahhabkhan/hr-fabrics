{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "christophrumpel/artisan-benchmark": "^0.0.4",
        "inertiajs/inertia-laravel": "^3.3.4",
        "intervention/image": "^4.3.2",
        "kirschbaum-development/eloquent-power-joins": "^4.3.3",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.31.0",
        "laravel/horizon": "^5.49.0",
        "laravel/nightwatch": "^1.30",
        "laravel/passkeys": "^0.2.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "league/flysystem-path-prefixing": "^3.31",
        "spatie/laravel-login-link": "^1.6.7",
        "tightenco/ziggy": "^2.6.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.3",
        "larastan/larastan": "^3.12.1",
        "laravel/boost": "^2.9.0",
        "laravel/breeze": "^2.4.2",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.67.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.2.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-drift": "^v5.0.0",
        "pestphp/pest-plugin-faker": "^v5.0.0",
        "pestphp/pest-plugin-laravel": "^v5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-profanity": "^v5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "pestphp/pest-plugin-type-coverage": "^v5.0.2",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "check:pr": [
            "composer validate --strict",
            "rector",
            "phpstan",
            "pint --parallel",
            "npm run lint",
            "@php artisan config:clear --ansi",
            "@test:code-coverage"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php artisan permissions:generate"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test:code-coverage": "pest --coverage --compact --min=71",
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
